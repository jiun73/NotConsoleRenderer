<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="unit_test_console" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Script file="lib_finder.script" />
			<Target title="Debug">
				<Option output="bin/Debug/unit_test_console" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="../../ntp/bin/Debug/libntp_codeblock.a" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/unit_test_console" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="../../ntp/bin/Release/libntp_codeblock.a" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-fexceptions" />
		</Compiler>
		<Unit filename="ntp_client_console.cpp" />
		<Unit filename="tests.cpp" />
		<Unit filename="tests.h" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
