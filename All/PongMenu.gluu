new style GLUU default
new string message

new function :join = 
{
	arg string ip;
	$if { :join_game ip :not }
	{
		message = { "could not join " ip };
	};
	ip = "";
	return_code = 1;
}

row <
col fixed <


	row px 100
	<
		new string ip = 127.0.0.1

		col  button Host { message = "hosting game!"; :host_game; return_code = 2;}  style GLUU key
		col  button Join { :join ip }  style GLUU key

		col textbox { "Enter ip ....... " } { ip } { :join ip } 
	>
	row px 400 
	<
		col text { message } <>
	>
	row px 100 
	<
		col px 100 button Testing { :exit }
	>
> >