new vector(AnimationX) animations
new vector(string) animation_names
new vector(string) paths
new int current_frame = 0
new int current_animation = 0
new int current_image = 0

new int state = 0

new function :curanim = 
{
	animations -at current_animation
}

new function :curframe = 
{
	:curanim .frames -at current_frame
}

new init setup = { BASE .fit = true; }

new function :load_images = 
{
	vector(string) files = $files;
	int index = 0;

	$while { index < -size files } {
		files -at index :get_tex;
		paths -push {files -at index};
		index ++;
	};
}

new function :has_image = { paths -size > 0  }
new function :has_anim = { animations -size > 0 }
new function :animation_size =  { :curanim .frames -size }

new function :has_frames = 
{
	$if :has_anim  
	{
		return { :curanim .frames -size > 0 } 
	};
	:false;
}

new function :has_textures = 
{
	$if :has_anim 
	{
		return { :curanim .textures -size > 0 }
	};
	:false;
}

new function :add_frame =
{
	arg string path;
	arg* AnimationX anim;

	$if { @ anim .textures -has :get_tex path :not }
	{ 
		 @ anim .textures -push :get_tex path ;
	};

	int pos = { @ anim .textures -find :get_tex path };

	AnimationFrameX frame;

	frame .tex = (size_t) pos;
	frame .time = (u32) 100;

	@ anim .frames -push frame;
}

new function :set_origins_ratio = {
	arg double ratioY;
	arg double ratioX;

	int i = 0;

	$foreach { :curanim .frames }
	{
		V2d_i tex_size = { :curanim .textures -at (size_t-int) { :curanim .frames -at i .tex } :get_tex_sz };

		:curanim .frames -at i .origin .x = {tex_size .x (.) !* ratioX (~)};
		:curanim .frames -at i .origin .y = {tex_size .y (.) !* ratioY (~)};

		i ++;
	};
}

row if { state == 2 } < 
	col fixed <
		row px 30 button Back { state = 1 } <>
	>
>

row if { state == 1 } < 
	col fixed <
		row px 30 button Back { state = 0 } <>
		row px 30 button { "Collider data"} { state = 2 } <>
	>
>

row if { state == 0 } < col fixed <

row px 30 <
	col px 120 button { "Load images" } { :load_images } <>
	col px 900 dropbox {paths} {current_image} <>
	col px 100 button Export 
	{ 
		string path = $new_file;
		$if { path -size == 0 } { return {}; };

		:write_anim_to_file {path ".anim"} animations;
	} <>
	col px 100 button Import 
	{ 
		string path = $file;
		$if { path -size == 0 } { return {}; };

		animations = :read_anim_from_file path; 
		int i = 0;
		$foreach animations 
		{
			:cout { {animations -at i} .name};
			animation_names -push { {animations -at i }.name }; 
			i++;
		}
	} <>
	col px 120 button Extensions {
		state = 1
	}
>

row px 30 fixed <
	new bool makingAnim = false 

	col px 140 if { :not makingAnim }	button	{ "New Animation" }	{ makingAnim = :true } <>
	col px 170 if { :not makingAnim } dropbox {animation_names} {current_animation} <>
	col px 140 if { makingAnim }		textbox { "Enter name..." }	
	{ 
		arg* string text; 

		AnimationX new_anim;
		new_anim .name = @ text;
		animation_names -push @ text;
		animations -push new_anim;

		:cout { "Added " @ text " animation" };

		makingAnim = :false; 
		@ text = ""; 
	} 
	<>
	col fixed px 140 if { makingAnim }		button	{"Cancel"}			{ makingAnim = :false } <>

	col fixed px 150 if { :has_anim :and :has_image } button { "Add frame" } 
			{
				& :curanim :add_frame { paths -at current_image} ;
			} <>

	col fixed px 150 if { :has_anim :and :has_image } button { "Add all images" } 
	{
		new int i;
		i = 0;
		$foreach paths 
		{
			& :curanim :add_frame { paths -at i };
			i ++;
		};
		
	} <>

	col <
		row fixed px 30 if { :has_frames } <
			col px 70 text { current_frame " / " { :animation_size - 1} } <>

			col px 40 button { "Prev" }  
			{
				$if { current_frame > 0 } 
				{ current_frame -- }
			} <>


			col px 40 button { "Next" }  
			{
				$if {current_frame <  { :animation_size - 1} } 
				{current_frame ++}
			} <>

			
			
		>
	>
>

new bool state = false

row px 800 <
	col fixed px 4 if { :has_frames } FRAME_CREATOR { :curanim } { :curframe } <>


	col px 1 if { :has_frames } 
	<
		row fixed ANIMATION_PREVIEW { :curanim } <>
		row < col fixed < 
			

			row px 30 if { :not state } text { "Size: " { :get_tex_sz { :curanim .textures -at (size_t-int) { :curframe .tex} } } } <>

			row px 30 if { :not state } textbox { "Origin: " :curframe .origin } { 
				arg* string text; 
				:curframe .origin #= @ text;
				@ text = ""; 
			} <> 

			row px 30 if { :not state }
			<
				col px 5 textbox { "Speed: " :curframe .time } { 
					arg* string text; 
					:curframe .time #= @ text;
					@ text  = ""; 
				} <>
			>

			row px 30 if { :not state } button { "More... " } { state = :true; } <>
			row px 30 if { state } button { "Close" } { state = :false; } <>
			row px 30 if { state } button { "Copy settings to all frames" } 
			{
				int i = 0;
				$foreach { :curanim .frames }
				{
					:curanim .frames -at i .origin = { :curframe .origin } ;
					:curanim .frames -at i .time = { :curframe .time } ;

					i ++;
				};
			} <>

			new double ZERO = 0
			new double HALF = 0.5
			new double ONE = 1

			row px 30 if { state }
			<
				col button { "*" } { :set_origins_ratio ZERO ZERO } <>
				col button { "*" } { :set_origins_ratio HALF ZERO } <>
				col button { "*" } { :set_origins_ratio ONE ZERO } <>
			>

			row px 30 if { state }
			<
				col button { "*" } { :set_origins_ratio ZERO HALF } <>
				col button { "*" } { :set_origins_ratio HALF HALF } <>
				col button { "*" } { :set_origins_ratio ONE HALF } <>
			>

			row px 30 if { state }
			<
				col button { "*" } { :set_origins_ratio ZERO ONE } <>
				col button { "*" } { :set_origins_ratio HALF ONE } <>
				col button { "*" } { :set_origins_ratio ONE ONE } <>
			>
		>>

	>
>
>

