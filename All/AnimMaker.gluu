new vector(AnimationX) animations
new vector(string) animation_names
new vector(string) paths
new int current_frame = 0
new int current_animation = 0
new int current_image = 0

new int state = 0

new vector(AnimationXColliders) colliders
new bool collider_mode = false

new function :curanim = 
{
	animations -at current_animation
}

new function :curcolliders = 
{
	$while { colliders -size /- { animations -size }  }
	{
		AnimationXColliders n;
		colliders -push n;
	};

	colliders -at current_animation;
}

new function :curframe = 
{
	:curanim .frames -at current_frame
}

new init setup = { BASE .fit = true; }

new function :load_images = 
{
	vector(string) files = $files;
	int index = 0;

	$while { index /- -size files } {
		files -at index :get_tex;
		paths -push {files -at index};
		index ++;
	};
}

new function :has_image = { paths -size > 0  }
new function :has_anim = { animations -size > 0 }
new function :animation_size =  { :curanim .frames -size }

new function :has_colliders = { colliders -size > 0 }
new function :has_tags = 
{ 
	$if { :has_colliders :not } { return :false; };
	:curcolliders .tags -size > 0 
}

new function :has_frames = 
{
	$if :has_anim  
	{
		return { :curanim .frames -size > 0 } 
	};
	:false;
}

new function :has_textures = 
{
	$if :has_anim 
	{
		return { :curanim .textures -size > 0 }
	};
	:false;
}

new function :add_frame =
{
	arg string path;
	arg* AnimationX anim;

	$if { @ anim .textures -has :get_tex path :not }
	{ 
		 @ anim .textures -push :get_tex path ;
	};

	int pos = { @ anim .textures -find :get_tex path };

	AnimationFrameX frame;

	frame .tex = (size_t) pos;
	frame .time = (u32) 100;

	@anim .frames -push frame;
}

new function :set_origins_ratio = {
	arg double ratioY;
	arg double ratioX;

	$foreach { :curanim .frames }
	{
		arg* AnimationFrameX frame;
		V2d_i tex_size = { :curanim .textures -at (size_t-int) { @frame .tex } :get_tex_sz };

		@frame .origin .x = {tex_size .x (.) !* ratioX (~)};
		@frame .origin .y = {tex_size .y (.) !* ratioY (~)};
	};
}

new style GLUU

row if { state == 1 } popup { :rect 20 20 100 100 } < 
	col <
		row px 100 button Back { state = 0 } <>
		row px 100 checkbox { collider_mode } { "Hello !! (" collider_mode ")"  } <>
	>
>

row < col fixed <

row px 30 <

	col px 120 button { "Load images" } { :load_images } style GLUU key <>
	col px 900 dropbox {paths} {current_image} <>
	col px 100 button Export 
	{ 
		string path = $new_file;
		$if { path -size == 0 } { return {}; };

		:write_anim_to_file {path ".anim"} animations;
	} <>
	col px 100 button Import 
	{ 
		string path = $file;
		$if { path -size == 0 } { return {}; };

		animations = :read_anim_from_file path; 
		$foreach animations 
		{
			arg* AnimationX a;
			@a .name :cout;
			animation_names -push { @a .name }; 
		}
	} <>
	col px 120 button Extensions {
		
		state = 1
	}
>

row px 30 fixed <
	new bool makingAnim = false 

	col px 140 if { :not makingAnim }	button	{ "New Animation" }	{ makingAnim = :true } <>
	col px 170 if { :not makingAnim } dropbox {animation_names} {current_animation} <>
	new string anim_name
	col px 140 if { makingAnim }		textbox { "Enter name..." }	{ anim_name }
	{ 

		AnimationX new_anim;
		new_anim .name = anim_name;
		animation_names -push anim_name;
		animations -push new_anim;

		:cout { "Added " anim_name " animation" };

		makingAnim = :false; 
		anim_name = ""; 
	} 
	<>
	col fixed px 140 if { makingAnim }		button	{"Cancel"}			{ makingAnim = :false } <>

	col fixed px 150 if { :has_anim :and :has_image } button { "Add frame" } 
			{
				& :curanim :add_frame { paths -at current_image} ;
			} <>

	col fixed px 150 if { :has_anim :and :has_image } button { "Add all images" } 
	{
		$foreach paths 
		{
			arg* string path;
			& :curanim :add_frame @path;
		};
		
	} <>

	col <
		row fixed px 30 if { :has_frames } <
			col px 70 text { current_frame " / " { :animation_size - 1} } <>

			col px 40 button { "Prev" }  
			{
				$if { current_frame > 0 } 
				{ current_frame -- }
			} <>


			col px 40 button { "Next" }  
			{
				$if {current_frame <  { :animation_size - 1} } 
				{current_frame ++}
			} <>

			
			
		>
	>
>

new bool state = false
new bool collider_state = false

row px 800 <
	new int anchor_i = -1

	col fixed px 4 if { :has_frames } FRAME_CREATOR { :curanim } { :curframe } { anchor_i } { :curcolliders } <>


	col px 1 if { :has_frames } 
	<
		row fixed ANIMATION_PREVIEW { :curanim } <>
		row < col fixed < 
			row px 30 if { :not state } text { "Size: " { :get_tex_sz { :curanim .textures -at (size_t-int) { :curframe .tex} } } } <>

			new string origin_name
			row px 30 if { :not state } textbox { "Origin: " :curframe .origin } {origin_name} { 
				:curframe .origin #= origin_name;
				origin_name = ""; 
			} <> 

			new string speed_string
			row px 30 if { :not state }
			<
				col px 5 textbox { "Speed: " :curframe .time } { speed_string } { 
					:curframe .time #= speed_string;
					speed_string = ""; 
				} <>
			>

			

			row px 30 if { :not state }
			<
				new string new_anchor_name
				col px 5 textbox { "New anchor" } { new_anchor_name }
				{
					pair(string-V2d_i) pair;
					pair .first = new_anchor_name;
					pair .second = :vec 0 0;

					:curframe .anchors -push pair;
					new_anchor_name = "";
				}
			>

			row px 30 if { :not state :and { :curframe .anchors -size /+ 0 } }
			<
				col px 5 button Prev 
				{
					$if { anchor_i /+ { 0 - 1 } } 
					{ anchor_i -- }
				} <>
				col px 5 button Next 
				{
					$if { anchor_i /-  { { :curframe .anchors -size } - 1} } 
					{ anchor_i ++ }
				} <>
				col px 15 if { anchor_i /+ { 0 - 1 } } text 
				{ 
					{ " " { :curframe .anchors -at anchor_i } };
				} <>
				col px 15 if { anchor_i == { 0 - 1 } } text { "Origin "} <>
			>

			row px 30 if { :not state } button { "More... " } { state = :true; } <>

			row px 30 if { :not state :and collider_mode :and :not collider_state } <
				col button { "Add colliders" } 
				{
					collider_state = :true
				} <>
			> 

			row px 30 if { :not state :and collider_mode :and collider_state } <
				new string tag_name
				col textbox { "new tag" } { tag_name }
				{
					$if { :curcolliders .tags -has_key tag_name :not }		
					{													
						var key;										
						key ~ { :curcolliders .tags -new_obj };	
						FrameXColliderSet set;					
						:cout :type key;									
						key .first = tag_name;									
						:curcolliders .tags -push key;						
					}; 

					tag_name = "";
				}
			> 

			new int tag_i = 0
			new int box_i = 0

			new function :has_box = {
				$if { :has_tags :not } { return :false; };
				{ :curcolliders .tags -at tag_i } .second .colliders -size > 0
			}

			new function :curboxes = {
				return :curcolliders .tags -at tag_i .second .colliders
			}

			row px 30 if { :not state :and collider_mode :and :not :has_tags }
			<
				col px 30 text { "no tags" } <>
			>

			row px 30 if { :not state :and collider_mode :and :has_tags }
			<
				col px 60 <
					row <
						col text { :curcolliders .tags -at tag_i .first }
					>
					row <
						col px 30 button { "<" } {tag_i --; $if { tag_i /- 0 } { tag_i = { :curcolliders .tags -size - 1 } } } <>
						col px 30 button { ">" } {tag_i ++; $if { tag_i /+ { :curcolliders .tags -size - 1 } } { tag_i = 0 }; } <>
					>
				>
				
				col px 30 button { "+" } 
				{
					FrameXCollider boxes;
					boxes .anchor = "Origin";
					boxes .bounds = :rect 10 10 10 10;
					:curcolliders .tags -at tag_i .second .colliders -push boxes;
				}
			>

			//row px 30 if { :not state :and collider_mode :and :has_tags  }
			//<
			//	col px 30 text { :curcolliders .tags -at tag_i .second .colliders # }
			//>

			row px 30 if { :not state :and collider_mode :and :not :has_box  }
			<
				col px 30 text { "no boxes" } <>
			>

			row px 30 if { :not state :and collider_mode :and :has_box  }
			<
				col <
					row px 30 <
						col px 30 button { "<" } {box_i --; $if { box_i /- 0 } { box_i = { :curboxes -size - 1 } } } <>
						col px 30 button { ">" } {box_i ++; $if { box_i /+ { :curboxes -size - 1 } } { box_i = 0 }; } <>
					>

					new string new_collider_anchor
					row px 30 textbox { :curboxes -at box_i .anchor } { new_collider_anchor }
					{
						:curboxes -at box_i .anchor = new_collider_anchor;

						new_collider_anchor = "";
					} <>
				>
			>

			row px 30 if { state } button { "Close" } { state = :false; } <>
			row px 30 if { state } button { "Copy settings to all frames" } 
			{
				$foreach { :curanim .frames }
				{
					arg* AnimationFrameX frame;
					@frame .origin = { :curframe .origin } ;
					@frame .time = { :curframe .time } ;
				};
			} <>

			new double ZERO = 0
			new double HALF = 0.5
			new double ONE = 1

			row px 30 if { state }
			<
				col button { "*" } { :set_origins_ratio ZERO ZERO } style GLUU rounded <>
				col button { "*" } { :set_origins_ratio HALF ZERO } style GLUU rounded <>
				col button { "*" } { :set_origins_ratio ONE  ZERO } style GLUU rounded <>
			>

			row px 30 if { state }
			<
				col button { "*" } { :set_origins_ratio ZERO HALF } style GLUU rounded <>
				col button { "*" } { :set_origins_ratio HALF HALF } style GLUU rounded <>
				col button { "*" } { :set_origins_ratio ONE  HALF } style GLUU rounded <>
			>

			row px 30 if { state }
			<
				col button { "*" } { :set_origins_ratio ZERO ONE  } style GLUU rounded <>
				col button { "*" } { :set_origins_ratio HALF ONE  } style GLUU rounded <>
				col button { "*" } { :set_origins_ratio ONE  ONE  } style GLUU rounded <>
			>
		>>

	>
>
>

